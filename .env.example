# Marketbing server settings & API keys
#
# HOW TO USE (one-time setup):
#   1. Copy this file and rename the copy to exactly:  .env
#   2. Fill in the values after the = signs (no quotes needed).
#   3. Restart the server.
#
# The .env file is ignored by git on purpose — secrets must never be
# committed to the repository. This example file IS committed, so put no
# real keys in here.

# ---- Server (safe to leave as-is) ----------------------------------
# Port the app runs on.
PORT=8787

# ---- Sign-in (required) -------------------------------------------
# The account that can sign in to the app. It is created on first start.
# To change the password later, change it here and restart: every device
# that was signed in is signed out. There is no public sign-up page.
# Use a password of at least 10 characters that you don't use elsewhere.
OWNER_EMAIL=
OWNER_PASSWORD=

# Only when the server runs behind a hosting proxy (Render sets this in
# render.yaml): lets failed sign-ins be limited per visitor, not per proxy.
# Leave empty when running on your own computer.
TRUST_PROXY=

# ---- Android app ---------------------------------------------------
# Address of your hosted server (e.g. https://marketbing.onrender.com),
# used only by `npm run build:android`. Must start with https://.
ANDROID_API_URL=

# Extra web addresses allowed to call the API from another site, comma
# separated. Not needed for the Android app, which is already allowed.
CORS_ORIGINS=

# ---- Database -------------------------------------------------------
# Leave DATABASE_URL empty to use a local database file (DB_FILE) — fine
# for trying things out on one computer.
#
# To use Supabase (hosted Postgres), paste your connection string here:
#   Supabase dashboard → your project → "Connect" (top bar) → Session pooler
#   → copy the URI, and replace [YOUR-PASSWORD] with your database password.
# It looks like:
#   postgresql://postgres.abcd1234:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Recommended with Supabase: verifies you are really talking to Supabase.
# Download it from Project Settings → Database → SSL Configuration →
# "Download certificate", save it in this folder, and put its file name here.
# Example: DATABASE_CA_CERT=./supabase-ca.crt
DATABASE_CA_CERT=

# Local database file, used only when DATABASE_URL is empty.
DB_FILE=./data/marketbing.db

# Where the editable workspace files live.
CONFIG_DIR=./config

# ---- API keys (reserved for upcoming integrations) -----------------
# These are not used by the app yet. They are the slots where real
# integration keys will go, so they already have a proper home.

# AI planning (Claude API) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Meta / Instagram marketing APIs
META_ADS_ACCESS_TOKEN=
INSTAGRAM_GRAPH_TOKEN=

# Email sending provider
EMAIL_PROVIDER_API_KEY=

# Payment / payout provider
PAYMENTS_API_KEY=
